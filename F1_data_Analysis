        "wins_by_driver = wins_by_driver.merge(\n",
        "    drivers[[\"driver_id\", \"full_name\", \"nationality\"]],\n",
        "    on=\"driver_id\",\n",
        "    how=\"left\"\n",
        ")\n",
        "\n",
        "# Top 10\n",
        "top10_drivers = wins_by_driver.sort_values(\"wins\", ascending=False).head(10)\n",
        "display(top10_drivers)"
